# ローカル ComfyUI 環境の固定バージョン(docs/08-local-comfyui.md)
# 変更は単独の変更として行い、変更後に `npm run comfyui:setup` で動作確認すること。

# ComfyUI 本体(git タグ)
COMFYUI_TAG=v0.45.6

# ComfyUI-GGUF(タグが無いためコミットで固定)
GGUF_NODE_COMMIT=6ea2651e7df66d7585f6ffee804b20e92fb38b8a

# Python(メジャー.マイナー)
PYTHON_VERSION=3.12

# PyTorch(macOS は PyPI、Windows は TORCH_CUDA_INDEX の CUDA 版。ローカルバージョン +cuXXX は自動で一致する)
TORCH_VERSION=2.15.0
TORCHVISION_VERSION=0.29.2
TORCHAUDIO_VERSION=2.11.1
TORCH_CUDA_INDEX=https://download.pytorch.org/whl/cu130

COMFYUI_REPO=https://github.com/comfyanonymous/ComfyUI
GGUF_NODE_REPO=https://github.com/city96/ComfyUI-GGUF
